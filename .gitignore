tools
# CMake build trees and generated project files
/rebuild/build/
/build/
/out/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
install_manifest.txt
compile_commands.json

# Local Ninja/MSVC build trees used on this workstation.  The upstream rules
# above only cover /build/ and /out/, so these have to be listed explicitly or
# the whole toolchain output (~490 MB) would be staged.
/build2/
/build_ninja/

# Vendored third-party archives.  The unpacked sources are versioned
# (third_party/quickjs-0.9.0/), the downloaded archives are not.
/third_party/*.zip
/third_party/*.7z

# Original TTPlayer installation tree.  These root-level runtime files mirror
# C:\Program Files (x86)\TTPlayer and are not reconstruction sources.  Skin/
# is deliberately NOT ignored because legacy skin packages are versioned.
/AddIn/
/Icons/
/Lyrics/
/PlayList/
/RealCodec/
/Skin/*.xml
/Skin/new/*.xml
/FAQ.txt
/mp3PRO.dll
/msdmo.dll
/tak_deco_lib.dll
/ttpcomm.dll
/TTPlayer.exe
/TTPlayer.rll
/TTPlayerRebuild.rll
/TTPlayer.xml
/TTPlayerRebuild.xml
/TTPlayerRebuild.exe
/TTPlayerSet.exe
/ttpres.dll
/uninstall.exe
/WMADMOD.DLL
/卸载.exe


/reverse

# Local archive of the original installation.
/TTPlayer.7z

